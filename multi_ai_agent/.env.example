# Copy to .env and adjust. Environment variables override config.yaml.
# MAA_CONFIG=./config.yaml
MAA_HOST=127.0.0.1
MAA_PORT=8000
# MAA_ALLOW_PUBLIC=false        # must be true to bind 0.0.0.0
MAA_DEVICE=auto                 # auto | cuda | mps | cpu
MAA_OFFLINE_MODE=true
MAA_LOG_LEVEL=info
# MAA_JSON_LOGS=false
# MAA_GPU_CONCURRENCY=1
# MAA_VRAM_THRESHOLD=0.85
# MAA_MODELS_DIR=./models

# Restrict which GPU(s) the process can see (standard CUDA variable):
# CUDA_VISIBLE_DEVICES=0

# Only needed by scripts/download_models.py for gated/private models:
# HF_TOKEN=hf_xxx

# ==============================
# LOCAL AI (all inference runs on your NVIDIA GPU; there is no cloud option)
# ==============================
AI_MODE=local
# MODEL_PATH=./models/text/research        # active research/reasoning model (any HF folder or GGUF folder)
# FAST_MODEL_PATH=./models/text/fast_text  # small model for queries / relevance / gap checks
# REASONING_MODEL_PATH=./models/text/Qwen3-14B
# DEVICE=cuda                              # alias of MAA_DEVICE
# CUDA_DEVICE=0                            # pin a GPU index (default: GPU with most free memory)
# DTYPE=bfloat16                           # dtype of the research model (float16 on pre-Ampere GPUs)
# MAX_CONTEXT_LENGTH=8192
# MAX_NEW_TOKENS=2048
# INFERENCE_ENGINE=transformers            # transformers | llama_cpp | vllm
# GPU_MODE=single                          # multi is reserved for future multi-GPU support

# ==============================
# RESEARCH
# ==============================
# MAX_RESEARCH_ITERATIONS=5
# MAX_SEARCH_RESULTS=10
# MAX_SOURCES=10
# RESEARCH_DEPTH=normal                    # quick | normal | deep
# SEARCH_PROVIDER=ddgs                     # ddgs (DuckDuckGo, no key) | searxng
# SEARXNG_URL=http://127.0.0.1:8888

# ==============================
# WEB
# ==============================
# WEB_ENABLED=true                         # false = LOCAL AI + OFFLINE (no web requests)
# REQUEST_TIMEOUT=20
# MAX_PAGE_SIZE_MB=10

# Cloud LLM keys (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, ...) are never used: the app removes
# them from its own environment at startup.
