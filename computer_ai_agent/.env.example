# ---------- local model (no cloud APIs) ----------
# ollama       = use the local Ollama server (default; runs on your NVIDIA GPU)
# transformers = load MODEL_PATH with Hugging Face transformers on GPU_DEVICE (pip install -r requirements-gpu.txt)
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3.6:27b          # must accept images (Qwen3.x / Qwen-VL / Gemma 3+ / Llama 3.2 Vision ...)
VISION_MODEL_NAME=              # empty = same as MODEL_NAME
FAST_MODEL_NAME=                # optional smaller model for cheap calls; empty = MODEL_NAME
OLLAMA_URL=http://127.0.0.1:11434
MODEL_PATH=                     # transformers: local model directory, e.g. /models/Qwen2.5-VL-7B-Instruct
VISION_MODEL_PATH=
GPU_DEVICE=0
GPU_MEMORY_LIMIT=               # transformers only, e.g. 20GiB
MAX_CONTEXT=16384
TEMPERATURE=0.1
MODEL_TIMEOUT=180
MODEL_KEEP_ALIVE=30m

# ---------- screen + control ----------
AGENT_DISPLAY=                  # X display to control; empty = $DISPLAY (use e.g. :7 for a nested Xephyr test screen)
SCREEN_FPS=2                    # live preview frames per second in the web UI
VISION_MODE=auto                # auto | always | never  (when the model also gets the screenshot)
MODEL_IMAGE_WIDTH=1280          # screenshots are downscaled to this width for the model
OCR_ENABLED=true
ACCESSIBILITY_ENABLED=true
ACTION_DELAY=0.35
SETTLE_TIMEOUT=1.2               # max wait for the window to stop changing after an action
NAV_TIMEOUT=5                   # max wait for a page/view change after a link click / Enter
LAUNCH_TIMEOUT=25
CHROME_USER_DATA_DIR=           # optional: drive Chrome with a separate profile

# ---------- agent loop + safety ----------
MAX_ACTION_RETRIES=3
MAX_STEPS_PER_SUBTASK=25
REQUIRE_CONFIRMATION=true       # ask before deleting, sending, buying, publishing, dangerous shell commands...
CONFIRMATION_TIMEOUT=300

# ---------- server ----------
HOST=127.0.0.1                  # keep it local: the panel can move your mouse and type
PORT=8765
DEBUG=false                     # true = save screenshots/OCR/decisions per step in logs/tasks/<task_id>/
HARNESS_DIR=                    # planner harness (planner/harness.py); empty = ./harness
